{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.invalid/schemas/hypergraph-edge.schema.json",
  "type": "object",
  "required": [
    "edge_id",
    "relation",
    "participants",
    "status",
    "provenance",
    "observed_at"
  ],
  "properties": {
    "edge_id": {
      "type": "string"
    },
    "relation": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "role"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "candidate",
        "reviewed",
        "verified",
        "rejected"
      ]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_uri",
          "source_revision",
          "evidence_ref",
          "evidence_digest",
          "evidence_type"
        ],
        "properties": {
          "source_uri": {
            "type": "string",
            "format": "uri"
          },
          "source_revision": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          },
          "evidence_digest": {
            "type": "object",
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          "evidence_type": {
            "type": "string"
          }
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "verification_note": {
      "type": "string"
    },
    "review_outcome": {
      "enum": [
        "not_reviewed",
        "not_observed_in_reviewed_scope",
        "source_reference_found",
        "contract_verified",
        "runtime_verified"
      ],
      "description": "Evidence review outcome; separate from graph truth/status. Negative observations are limited to the reviewed scope."
    },
    "review": {
      "type": "object",
      "required": [
        "reviewed_at",
        "method",
        "conclusion",
        "evidence",
        "limitations"
      ],
      "properties": {
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repository",
              "path",
              "blob_sha",
              "role"
            ],
            "properties": {
              "repository": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "blob_sha": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
